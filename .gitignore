# Variáveis de ambiente (senhas, URLs de banco)
.env
.env.*
!.env.example

# Ambiente virtual
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Testes e cobertura
.pytest_cache/
.coverage
htmlcov/

# Bancos locais (SQLite de teste/CI)
*.db
*.sqlite3

# Editores e sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Backup do .git antigo
.git-antigo/

# Dados gerados pelo pipeline (Bronze/Silver/Gold) — o código fica versionado, os dados não
backend/data/bronze/**/*.*
backend/data/silver/**/*.*
backend/data/gold/**/*.*
!backend/data/**/.gitkeep