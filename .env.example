# Copie este arquivo para .env e preencha com seus valores

# PostgreSQL local (Docker)
POSTGRES_USER=metacerta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=metacerta_db

# URL que a aplicação e o Alembic usam
# Driver psycopg (v3). Deixar o "+psycopg" explícito evita depender do padrão do SQLAlchemy
DATABASE_URL=postgresql+psycopg://metacerta:troque-esta-senha@localhost:5432/metacerta_db
# Usando Neon: DATABASE_URL=postgresql+psycopg://usuario:senha@host.neon.tech/neondb?sslmode=require

# pgAdmin (interface visual do banco)
PGADMIN_DEFAULT_EMAIL=admin@metacerta.dev
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha

# Neon (produção, Sprint 7)
# NEON_DATABASE_URL=postgresql+psycopg://usuario:senha@host.neon.tech/banco?sslmode=require
